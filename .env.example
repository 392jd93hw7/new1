# Optional embed URL templates. Defaults are used when left unset.
# Supported placeholders: {ANILIST_ID}, {id}, {EPISODE}, {episode}, {audio}
# AniEmbed is retained as the default provider.
NEXT_PUBLIC_ANIEMBED_EMBED_TEMPLATE=https://aniembed.se/e/{ANILIST_ID}/{EPISODE}?lang={audio}
NEXT_PUBLIC_ANIXO_EMBED_TEMPLATE=https://anixo.buzz/embed/ani/{ANILIST_ID}/{EPISODE}?track={audio}
# Use player.yenime.net for the iframe player. dub=0 means Sub; dub=1 means Dub.
NEXT_PUBLIC_YENIME_EMBED_TEMPLATE=https://player.yenime.net/anime/ani/{ANILIST_ID}/{EPISODE}?dub={dub}
