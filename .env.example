# Optional overrides for the documented provider embed URL templates below.
# The defaults are configured in src/lib/streaming/providers/.
# Values prefixed with NEXT_PUBLIC_ are exposed to browsers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional:
# NEXT_PUBLIC_ANIEMBED_EMBED_TEMPLATE=https://aniembed.se/e/{ANILIST_ID}/{EPISODE}?lang={audio}
# NEXT_PUBLIC_NOVUSCLOUD_EMBED_TEMPLATE=https://novuscloud.buzz/embed/ani/{anilist_id}/{episode}/{type}
# NEXT_PUBLIC_ZOKOANIME_EMBED_TEMPLATE=https://zokoanime.video/stream/ani/{anilist_id}/{episode}/{audio}?color=a78bfa
